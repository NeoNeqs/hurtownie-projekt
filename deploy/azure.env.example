# Copy to .env on the VM:  cp deploy/azure.env.example .env
# The application does not read .env by itself; load it with:
#   set -a; source .env; set +a

# PostgreSQL is the Docker service on the same VM, loopback only.
WAREHOUSE_DSN=postgresql://warehouse:warehouse@localhost:55432/warehouse

# Use the distro Chrome instead of letting Selenium Manager download one.
BROWSER_BINARY=/usr/bin/google-chrome

# The non-npm browsers (Packagist, Hex, RubyGems, crates.io) run headless.
# The scale script sets this per spider as well; keep it true on a server.
BROWSER_HEADLESS=true
BROWSER_STEALTH=true
BROWSER_HUMANIZE=true

# Politeness. One request per domain, as in the local setup.
SCRAPY_DOWNLOAD_DELAY=0.5
SCRAPY_CONCURRENT_REQUESTS=8
SCRAPY_CONCURRENT_PER_DOMAIN=1
SCRAPY_LOG_LEVEL=INFO

# Optional: raise retry budgets for the HTTP ecosystems.
SCRAPY_DOWNLOAD_TIMEOUT=90
