# PostgreSQL connection used by warehouse.db and the storage pipeline.
WAREHOUSE_DSN=postgresql://warehouse:warehouse@localhost:55432/warehouse

# Browser
BROWSER_HEADLESS=false
BROWSER_POOL_SIZE=1
# Leave empty to use ~/.cache/hurtownie/chrome-profile (keeps cf_clearance).
BROWSER_PROFILE_DIR=
BROWSER_STEALTH=true
BROWSER_HUMANIZE=true
BROWSER_CHALLENGE_TIMEOUT=25
# Set >0 to pause for a human to solve a persistent challenge (headed mode only).
BROWSER_MANUAL_CHALLENGE_TIMEOUT=0

# Scraping politeness
SCRAPY_DOWNLOAD_DELAY=0.5
SCRAPY_CONCURRENT_REQUESTS=8
SCRAPY_CONCURRENT_PER_DOMAIN=1
SCRAPY_LOG_LEVEL=INFO

# npm pilot sampling
NPM_POPULAR_COUNT=25
NPM_RANDOM_COUNT=5
NPM_SAMPLE_SEED=1
NPM_SEARCH_QUERIES=framework,http,cli,testing,react
# npm answers chatty crawls with 429; wait this long before the first retry,
# then double the wait up to the maximum. Retry-After is honoured when sent.
NPM_RETRY_COOLDOWN_SECONDS=600
NPM_RETRY_MAX_COOLDOWN_SECONDS=3600
# 0 = keep retrying forever; the scraper waits until the site lets it back in.
NPM_RETRY_MAX_ATTEMPTS=0
# 0 = no cap on accumulated cool-down (same as retrying forever).
NPM_RETRY_MAX_TOTAL_COOLDOWN_SECONDS=0
# 0 = every row npm renders on the versions tab (about 120 max).
NPM_MAX_VERSIONS=3
# spread samples the release history evenly; downloads keeps the most downloaded.
NPM_VERSION_SELECTION=spread

# PyPI pilot sampling
PYPI_POPULAR_COUNT=25
PYPI_RANDOM_COUNT=5
PYPI_SAMPLE_SEED=1
PYPI_SITEMAP_SHARDS=5
PYPI_MAX_VERSIONS=10
PYPI_VERSION_SELECTION=spread

# RubyGems pilot sampling
# rubygems.org serves only ten stats pages, so the popular group is capped at
# 100 gems; larger values are silently capped by the spider.
RUBYGEMS_POPULAR_COUNT=25
RUBYGEMS_RANDOM_COUNT=5
RUBYGEMS_SAMPLE_SEED=1
RUBYGEMS_RANDOM_PAGES=3
RUBYGEMS_PAGE_LIMIT=1000
RUBYGEMS_MAX_VERSIONS=10
RUBYGEMS_VERSION_SELECTION=spread

# Hex pilot sampling
HEX_POPULAR_COUNT=25
HEX_RANDOM_COUNT=5
HEX_SAMPLE_SEED=1
HEX_RANDOM_PAGES=3
HEX_PAGE_LIMIT=767
HEX_MAX_VERSIONS=10
HEX_VERSION_SELECTION=spread

# Packagist pilot sampling
PACKAGIST_POPULAR_COUNT=25
PACKAGIST_RANDOM_COUNT=5
PACKAGIST_SAMPLE_SEED=1
PACKAGIST_MAX_VERSIONS=10
PACKAGIST_VERSION_SELECTION=spread

# NuGet pilot sampling
NUGET_POPULAR_COUNT=25
NUGET_RANDOM_COUNT=5
NUGET_SAMPLE_SEED=1
NUGET_RANDOM_PAGES=5
# The gallery stops paginating around page 1000.
NUGET_PAGE_LIMIT=1000
NUGET_MAX_VERSIONS=10
NUGET_VERSION_SELECTION=spread

# crates.io pilot sampling
CRATES_POPULAR_COUNT=25
CRATES_RANDOM_COUNT=5
CRATES_SAMPLE_SEED=1
CRATES_RANDOM_PAGES=5
# crates.io refuses alphabetical pages above ~200.
CRATES_PAGE_LIMIT=200
# 1 page is 100 releases; each extra page is one "Load More" click.
CRATES_VERSION_PAGES=1
CRATES_MAX_VERSIONS=10
CRATES_VERSION_SELECTION=spread
